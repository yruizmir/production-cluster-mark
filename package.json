{
  "name": "production-cluster-mark",
  "version": "0.2.1",
  "description": "Right-click a cluster and mark it as production: Lens then flags it with a coloured window edge, PRODUCTION labels and more, each configurable in Preferences → Extensions.",
  "license": "MIT",
  "author": "Yalton Ruiz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yruizmir/production-cluster-mark.git"
  },
  "homepage": "https://github.com/yruizmir/production-cluster-mark#readme",
  "bugs": {
    "url": "https://github.com/yruizmir/production-cluster-mark/issues"
  },
  "keywords": [
    "lens-extension"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@k8slens/badge": "^3.0.0",
    "@k8slens/cluster-contracts": "^2.1.2",
    "@k8slens/command-palette-contracts": "^1.0.2",
    "@k8slens/drop-down-menu-items": "^1.1.3",
    "@k8slens/element-components": "^3.9.0",
    "@k8slens/feature-core": "^7.5.2",
    "@k8slens/icon": "^4.0.0",
    "@k8slens/injectable": "^26.2.1",
    "@k8slens/input-components": "^1.0.1",
    "@k8slens/main-view-contracts": "^1.3.2",
    "@k8slens/navigator-components": "^1.0.3",
    "@k8slens/navigator-contracts": "^2.0.2",
    "@k8slens/notifications-contracts": "^1.0.2",
    "@k8slens/persistable-contracts": "^1.0.2",
    "@k8slens/preferences-contracts": "^2.0.0",
    "@k8slens/status-bar-contracts": "^1.0.2",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/top-bar-contracts": "^1.0.2",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "rimraf": "^4.4.1"
  }
}
